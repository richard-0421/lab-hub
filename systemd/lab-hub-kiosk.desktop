[Desktop Entry]
# TEMPLATE — scripts/install-pi.sh fills in the folder placeholder and installs the
# result as ~/.config/autostart/lab-hub-kiosk.desktop, so the fullscreen
# dashboard opens when the Pi's desktop session starts (X11 and Wayland).
# Delete that file to stop autostarting the kiosk.
Type=Application
Name=Lab Hub Kiosk
Comment=Open the Lab Hub dashboard fullscreen
Exec=/bin/bash "__APP_DIR__/kiosk.sh"
Terminal=false
X-GNOME-Autostart-enabled=true
